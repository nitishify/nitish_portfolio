# Copy to .env for local dev (npm run dev). On Vercel, set these in Project Settings > Environment Variables.

# Free: get a key at https://aistudio.google.com (default provider)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Optional paid backup if Gemini fails or hits its free limit
# ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-haiku-5-5

# Optional: force a provider (gemini or claude)
# CHAT_PROVIDER=gemini
